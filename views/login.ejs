<%- include('partials/header') %>

<section class="auth-page">
  <div class="auth-card">
    <div class="brand-badge auth-brand">
      <svg class="brand-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 21.5H6a3 3 0 0 1-3-3V7.5l5-5h9a3 3 0 0 1 3 3v4"></path>
        <path d="M3 7.5h4a1 1 0 0 0 1-1v-4"></path>
        <path d="M6.5 12l0.8 0.9 1.2-1.2"></path>
        <path d="M11.5 11h4.5M11.5 13h3"></path>
        <path d="M19.6 10.6a1.5 1.5 0 0 1 2.5 1.7l-5.4 7.7-3 1.6 0.5-3.3z"></path>
      </svg>
      <span class="brand-name">Taskflow</span>
    </div>

    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Log in to pick up where you left off.</p>

    <!-- Makes POST request to /login route -->
    <form class="auth-form" action="/login" method="POST">
      <label class="auth-field" for="email">
        <span class="auth-label">Email</span>
        <span class="auth-input-wrap">
          <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M22 6l-10 7L2 6"></path>
          </svg>
          <input class="auth-input" type="email" id="email" name="username" placeholder="you@example.com" autocomplete="email" required>
        </span>
      </label>

      <label class="auth-field" for="password">
        <span class="auth-label">Password</span>
        <span class="auth-input-wrap">
          <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <input class="auth-input" type="password" id="password" name="password" placeholder="Your password" autocomplete="current-password" required>
        </span>
      </label>

      <button type="submit" class="auth-btn auth-btn-primary">Log in</button>
    </form>

    <div class="auth-divider"><span>or</span></div>

    <a class="auth-btn auth-btn-social" href="/auth/google" role="button">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"></path>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"></path>
        <path fill="#FBBC05" d="M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84z"></path>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"></path>
      </svg>
      Continue with Google
    </a>

    <p class="auth-switch">New to Taskflow? <a href="/register">Create an account</a></p>
  </div>
</section>

<%- include('partials/footer') %>
