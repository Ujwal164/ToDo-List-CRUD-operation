<article class="task-card <%= item.status === 'completed' ? 'is-completed' : '' %>" data-task-id="<%= item.id %>" data-title="<%= item.title.toLowerCase() %>" data-status="<%= item.status %>" data-priority="<%= item.priority %>">
  <form class="status-form" action="/status" method="post"><input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="status" value="<%= item.status === 'completed' ? 'pending' : 'completed' %>"><label class="check-wrap"><input class="status-checkbox" type="checkbox" <%= item.status === 'completed' ? 'checked' : '' %>><span class="checkmark"></span></label></form>
  <div class="task-content"><div class="task-title-row"><h3><%= item.title %></h3><span class="priority priority-<%= item.priority %>"><%= item.priority %></span></div><div class="task-meta"><span class="category"><%= item.category %></span><% if (item.due_date) { %><span class="due-date" data-due-date="<%= item.due_date.toISOString ? item.due_date.toISOString().slice(0, 10) : item.due_date %>">◷ <%= new Date(item.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span><% } %></div></div>
  <div class="task-actions"><button class="icon-btn edit-task" type="button" aria-label="Edit task">✎</button><form action="/delete" method="post"><input type="hidden" name="deleteItemId" value="<%= item.id %>"><button class="icon-btn delete-task" type="submit" aria-label="Delete task">×</button></form></div>
  <form class="inline-edit" action="/edit" method="post"><input type="hidden" name="updatedItemId" value="<%= item.id %>"><input name="updatedItemTitle" value="<%= item.title %>" required><select name="updatedItemPriority"><option value="high" <%= item.priority === 'high' ? 'selected' : '' %>>High</option><option value="medium" <%= item.priority === 'medium' ? 'selected' : '' %>>Medium</option><option value="low" <%= item.priority === 'low' ? 'selected' : '' %>>Low</option></select><input type="date" name="updatedItemDueDate" value="<%= item.due_date ? (item.due_date.toISOString ? item.due_date.toISOString().slice(0, 10) : item.due_date) : '' %>"><select name="updatedItemCategory"><% ['Study', 'Work', 'Personal', 'Shopping'].forEach(category => { %><option <%= item.category === category ? 'selected' : '' %>><%= category %></option><% }) %></select><button type="submit" class="save-btn">Save</button></form>
</article>