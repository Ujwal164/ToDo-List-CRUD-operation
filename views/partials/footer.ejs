      <div class="footer-shortcuts">
        <span class="shortcut-tip"><kbd class="nm-kbd">/</kbd> Quick Search</span>
        <span class="shortcut-tip"><kbd class="nm-kbd">N</kbd> Focus New Task</span>
        <span class="shortcut-tip"><kbd class="nm-kbd">Esc</kbd> Clear Filters</span>
      </div>
      <p class="footer-copy">Taskflow &middot; Neumorphic Productivity Experience</p>
    </div>
  </footer>
